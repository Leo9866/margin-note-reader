OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=xhigh

# 可选：公开站点首次访问门禁。配置后用户需要输入 4 位邀请码才可进入网站。
# 多个邀请码可用英文逗号、中文逗号、空格或分号分隔。
SITE_INVITE_CODES=replace-with-4-digit-codes
SITE_INVITE_CHANNEL_NAME=你的公众号名称
SITE_INVITE_REPLY_KEYWORD=read
SITE_INVITE_QR_URL=/wechat-reader-qrcode.jpg
SITE_INVITE_HELP_URL=

# 可选：线上 AI 功能解锁门禁。配置后 /api/ai 和 /api/translate 会要求用户先输入口令。
# 多个口令可用英文逗号、中文逗号、空格或分号分隔。
AI_UNLOCK_CODES=replace-with-unlock-code
AI_UNLOCK_CHANNEL_NAME=你的公众号名称
AI_UNLOCK_REPLY_KEYWORD=阅读
AI_UNLOCK_QR_URL=/wechat-reader-qrcode.jpg
AI_UNLOCK_HELP_URL=
